{
  "name": "keeper",
  "productName": "Keeper",
  "version": "0.1.0",
  "description": "A free, open-source home for your files: visual library, plain-English search, text in images, download sources, duplicates, cleanup, space map, startup items and an optional AI assistant. Windows, macOS and Linux.",
  "license": "AGPL-3.0-or-later",
  "author": {
    "name": "Ashforde OÜ",
    "email": "contact@ashforde.org",
    "url": "https://github.com/ashfordeOU"
  },
  "homepage": "https://github.com/ashfordeOU/keeper",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashfordeOU/keeper.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "bin": {
    "keeper": "dist-cli/keeper.cjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,main,app \"vite\" \"node scripts/build-main.mjs --watch\" \"wait-on tcp:5180 file:dist-electron/main.cjs file:dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron .\"",
    "demo": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "npm run typecheck && npm test",
    "build": "npm run typecheck && vite build && node scripts/build-main.mjs",
    "build:cli": "node scripts/build-main.mjs --cli-only",
    "cli": "node scripts/build-main.mjs --cli-only && node dist-cli/keeper.cjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "onnxruntime-node": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "qrcode": "^1.5.4",
    "sharp": "^0.34.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@jsquash/jxl": "^1.3.0",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@zxing/library": "^0.21.3",
    "ag-psd": "^34.1.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "libheif-js": "^1.23.5",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sql.js": "^1.15.2",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "utif": "^3.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "xlsx": "^0.18.5"
  },
  "keywords": [
    "file manager",
    "disk cleaner",
    "duplicate finder",
    "search",
    "ocr",
    "clipboard",
    "productivity",
    "electron",
    "privacy",
    "agpl"
  ],
  "desktopName": "keeper.desktop"
}
