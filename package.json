{
  "name": "keeper",
  "productName": "Keeper",
  "version": "1.0.0",
  "description": "Keeper by Ashforde® — a free, source-available home for your files: visual library, plain-English search, text in images, download sources, duplicates, cleanup, space map, startup items and an optional AI assistant. Windows, macOS and Linux.",
  "license": "SEE LICENSE IN LICENSE.md",
  "author": {
    "name": "Ashforde OÜ",
    "email": "contact@ashforde.org",
    "url": "https://github.com/ashfordeOU"
  },
  "homepage": "https://github.com/ashfordeOU/keeper",
  "repository": {
    "type": "git",
    "url": "https://github.com/ashfordeOU/keeper.git"
  },
  "private": true,
  "type": "module",
  "main": "dist-electron/main.mjs",
  "bin": {
    "keeper": "dist-cli/keeper.cjs"
  },
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,main,app \"vite\" \"node scripts/build-main.mjs --watch\" \"wait-on tcp:5180 file:dist-electron/main.mjs file:dist-electron/preload.cjs && cross-env VITE_DEV_SERVER_URL=http://localhost:5180 electron .\"",
    "demo": "vite",
    "fetch:rclone": "node scripts/fetch-rclone.mjs",
    "fetch:agent-desktop": "node scripts/fetch-agent-desktop.mjs",
    "postinstall": "node scripts/fix-node-pty.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint:copy": "node scripts/lint-copy.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "node scripts/lint-copy.mjs && npm run typecheck && npm test",
    "build": "node scripts/license-txt.mjs && node scripts/lint-copy.mjs && npm run typecheck && vite build && node scripts/build-main.mjs",
    "build:cli": "node scripts/build-main.mjs --cli-only",
    "cli": "node scripts/build-main.mjs --cli-only && node dist-cli/keeper.cjs",
    "start": "electron .",
    "dist": "npm run build && node scripts/fetch-rclone.mjs && node scripts/fetch-agent-desktop.mjs && node scripts/build-mac-native.mjs && electron-builder",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && node scripts/fetch-rclone.mjs && node scripts/fetch-agent-desktop.mjs && node scripts/build-mac-native.mjs && electron-builder --mac",
    "dist:linux": "npm run build && electron-builder --linux",
    "notices": "node scripts/third-party-notices.mjs"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "asn1js": "^3.1.0",
    "basic-ftp": "^6.2.4",
    "dbus-next": "^0.10.2",
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "imapflow": "^2.10.0",
    "js-yaml": "^4.3.2",
    "libheif-js": "^1.23.5",
    "mailparser": "^3.14.1",
    "node-pty": "^1.1.0",
    "nodemailer": "^10.3.1",
    "onnxruntime-node": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pkijs": "^3.4.3",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@jsquash/jxl": "^1.3.0",
    "@lezer/highlight": "^1.2.5",
    "@replit/codemirror-vim": "^6.4.0",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/ssh2": "^1.15.6",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-image": "^0.9.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "@zxing/library": "^0.21.3",
    "ag-psd": "^34.1.0",
    "concurrently": "^10.0.6",
    "cross-env": "^10.1.0",
    "dompurify": "^3.4.17",
    "electron": "^45.2.0",
    "electron-builder": "^26.18.0",
    "emojilib": "^4.0.3",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "jsqr": "^1.4.0",
    "jszip": "^3.10.2",
    "katex": "^0.19.1",
    "mammoth": "^1.13.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rimraf": "file:tools/npm-compat/rimraf",
    "smtp-server": "^3.21.3",
    "sql.js": "^1.15.2",
    "three": "^0.187.0",
    "typescript": "^5.9.3",
    "unicode-emoji-json": "^0.9.0",
    "utif": "^3.1.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "keywords": [
    "file manager",
    "disk cleaner",
    "duplicate finder",
    "search",
    "ocr",
    "clipboard",
    "productivity",
    "electron",
    "privacy",
    "source-available"
  ],
  "desktopName": "keeper.desktop",
  "overrides": {
    "usocket": {
      "node-gyp": "^12.4.0"
    },
    "xml2js": "^0.6.2",
    "@electron/asar": "4.3.1",
    "@electron/universal": "3.0.6",
    "filelist": "^2.0.2",
    "minimatch": "^11.0.3",
    "global-agent": "^4.1.6",
    "lodash.isequal": "npm:fast-deep-equal@^3.1.3",
    "temp": {
      "rimraf": "$rimraf"
    },
    "glob": "^14.0.3"
  },
  "allowScripts": {
    "electron-winstaller": true,
    "esbuild": true,
    "ffmpeg-static": true,
    "fsevents": true,
    "node-pty": true,
    "onnxruntime-node": true,
    "usocket": true,
    "ssh2": false,
    "cpu-features": false,
    "tesseract.js": false
  }
}
