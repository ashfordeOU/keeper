<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Hardened-runtime exceptions for the Developer ID build (packaging/electron-builder.signed.cjs),
     used for the app and, inherited, for every program inside it (Electron's helpers, keeper-helper,
     Keeper Intents.app, agent-desktop, rclone, the native modules).
     - JIT and unsigned executable memory: Electron's JavaScript engine (V8) and WebAssembly.
     - Library validation off: native modules (sharp, onnxruntime, node-pty) and the libraries they load.
     - Microphone: dictation, the Island's mirror check, the teleprompter, recordings.
     - Camera: the Island's mirror.
     - Apple events: Music/Spotify, Notes, Finder, Terminal and System Events (paste, windows).
     - Calendars: the Island's events and reminders (keeper-helper, EventKit).
     - Location: the Toolbox's "where am I" (keeper-helper, CoreLocation).
     Screen Recording, Accessibility, Full Disk Access, Speech Recognition and notifications are
     granted by the person in System Settings and need no entitlement. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.automation.apple-events</key>
  <true/>
  <key>com.apple.security.personal-information.calendars</key>
  <true/>
  <key>com.apple.security.personal-information.location</key>
  <true/>
</dict>
</plist>
