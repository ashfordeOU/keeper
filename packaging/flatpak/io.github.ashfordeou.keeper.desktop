[Desktop Entry]
Type=Application
Name=Keeper
GenericName=File Library
Comment=Keeper by Ashforde® — find, understand and tidy your files
Exec=keeper %U
Icon=io.github.ashfordeou.keeper
Terminal=false
Categories=Utility;FileTools;
Keywords=files;search;duplicates;cleanup;screenshots;disk;space;
MimeType=x-scheme-handler/keeper;
StartupWMClass=keeper
StartupNotify=true
