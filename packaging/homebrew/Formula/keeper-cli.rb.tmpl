# Rendered by scripts/render-packaging.mjs and published to the ashfordeOU/homebrew-keeper tap.
# Only the `keeper` command (no app), for servers and terminals; works on macOS and Linux.
#   brew install ashfordeou/keeper/keeper-cli
# The cask installs the same command, so install one or the other.
class KeeperCli < Formula
  desc "Find, understand and tidy your files from the command line"
  homepage "https://github.com/ashfordeOU/keeper"
  url "https://github.com/ashfordeOU/keeper/releases/download/v{{version}}/keeper-cli-{{version}}.tgz"
  sha256 "{{sha256:keeper-cli-{{version}}.tgz}}"
  license "AGPL-3.0-or-later"

  livecheck do
    url :stable
    strategy :github_latest
  end

  depends_on "node"

  def install
    system "npm", "install", *std_npm_args
    bin.install_symlink libexec.glob("bin/*")
  end

  test do
    assert_match(/\d+\.\d+\.\d+/, shell_output("#{bin}/keeper --version"))
  end
end
