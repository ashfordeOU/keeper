<?xml version="1.0" encoding="utf-8"?>
<!-- Rendered by scripts/render-packaging.mjs. "keeper" is taken on the Chocolatey Community
     Repository by an unrelated product, so this package is keeper-files. -->
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
  <metadata>
    <id>keeper-files</id>
    <version>{{version}}</version>
    <title>Keeper</title>
    <authors>Ashforde OÜ</authors>
    <owners>ashfordeOU</owners>
    <projectUrl>https://github.com/ashfordeOU/keeper</projectUrl>
    <projectSourceUrl>https://github.com/ashfordeOU/keeper</projectSourceUrl>
    <packageSourceUrl>https://github.com/ashfordeOU/keeper/tree/main/packaging/chocolatey</packageSourceUrl>
    <bugTrackerUrl>https://github.com/ashfordeOU/keeper/issues</bugTrackerUrl>
    <docsUrl>https://github.com/ashfordeOU/keeper/blob/main/docs/INSTALL.md</docsUrl>
    <releaseNotes>https://github.com/ashfordeOU/keeper/releases/tag/v{{version}}</releaseNotes>
    <licenseUrl>https://github.com/ashfordeOU/keeper/blob/main/LICENSE</licenseUrl>
    <requireLicenseAcceptance>false</requireLicenseAcceptance>
    <iconUrl>https://raw.githubusercontent.com/ashfordeOU/keeper/main/build/icon.png</iconUrl>
    <copyright>Copyright © 2026 Keeper contributors</copyright>
    <tags>keeper files file-manager search duplicates cleanup disk-space foss</tags>
    <summary>Find, understand and tidy your files.</summary>
    <description><![CDATA[Keeper is a visual library for the files on your computer: plain-English search, on-device text recognition for screenshots, duplicates and look-alike photos, cache and download clean-up with previews and undo, and a `keeper` command with the same engine. Everything runs on your computer.

The package runs Keeper's official installer for all users and checks it against the SHA-256 published with the release.]]></description>
  </metadata>
  <files>
    <file src="tools\**" target="tools" />
  </files>
</package>
