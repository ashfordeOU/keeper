{
  "manifest_version": 3,
  "name": "Keeper by Ashforde® — Privacy",
  "version": "0.4.0",
  "description": "Shows Keeper which third parties each page loads, lets you control tabs and site permissions from Keeper, leaves Keeper cues on pages and shows Keeper's gentle block page during Focus. Talks only to the Keeper app on this computer.",
  "permissions": [
    "webRequest",
    "nativeMessaging",
    "tabs",
    "storage",
    "declarativeNetRequest",
    "contentSettings",
    "browsingData",
    "cookies",
    "proxy",
    "privacy",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "128": "icon128.png"
  },
  "key": "",
  "action": {
    "default_title": "Leave a Keeper cue for this page",
    "default_icon": {
      "128": "icon128.png"
    }
  },
  "commands": {
    "keeper-cue": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Leave a Keeper cue for this page"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
