<!-- Keeper Mesh helper as a LaunchDaemon (installed once, with the administrator dialog).
     Keeper fills in @RUNTIME@ (Keeper's own runtime, which must belong to root), @HELPER@
     (a root-owned copy of mesh-helper.cjs in /Library/PrivilegedHelperTools) and @ARGS@. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.ashforde.keeper.meshd</string>
  <key>ProgramArguments</key>
  <array>
    <string>@RUNTIME@</string>
    <string>@HELPER@</string>
    <string>@ARGS@</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>ELECTRON_RUN_AS_NODE</key>
    <string>1</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>StandardErrorPath</key>
  <string>/Library/Logs/Keeper/meshd.log</string>
</dict>
</plist>
