<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- SPDX-License-Identifier: LicenseRef-PolyForm-Shield-1.0.0 -->
<!-- NEEDS A DEVELOPER ID WITH THE NETWORK EXTENSION ENTITLEMENT: Apple must grant
     packet-tunnel-provider to the team, and the Developer ID provisioning profile must carry it.
     Developer ID distribution needs the -systemextension value; Xcode may write the legacy one, check it by hand. -->
<plist version="1.0">
<dict>
  <key>com.apple.developer.networking.networkextension</key>
  <array><string>packet-tunnel-provider-systemextension</string></array>
  <key>com.apple.security.app-sandbox</key><true/>
  <key>com.apple.security.network.client</key><true/>
  <key>com.apple.security.network.server</key><true/>
  <key>com.apple.security.application-groups</key>
  <array><string>$(TeamIdentifierPrefix)group.org.ashforde.keeper</string></array>
</dict>
</plist>
